# ========================
# DBMILESX - PRODUCAO
# ========================
APP_NAME=DBMILESX
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=https://SEU-DOMINIO.com.br
DEBUG=0

# Gere uma chave longa e aleatoria. NUNCA publique a chave real no GitHub.
SECRET_KEY=
SESSION_COOKIE=dbmilesx_session
SESSION_HTTPS_ONLY=1

# Banco
# Opcao A: SQLite em disco persistente
PERSISTENT_ROOT=/var/lib/dbmilesx
DATABASE_URL=
# Opcao B: PostgreSQL (recomendado para crescer)
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/dbmilesx

REGISTRATION_ENABLED=0
LOCAL_ADMIN_ENABLED=0
MAX_TEAM_USERS=10

# ========================
# AMADEUS SELF-SERVICE
# ========================
# Comece em test. So mude para production quando sua conta/chaves estiverem liberadas.
AMADEUS_ENABLED=0
AMADEUS_ENV=test
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_TIMEOUT_SECONDS=25
